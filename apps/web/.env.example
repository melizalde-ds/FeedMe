# For local development nothing here is needed: the defaults below work, and
# the anon key is read from the repo root .env (see vite.config.ts).
# To override one, copy this file to .env.local (git-ignored). Only VITE_*
# variables reach the browser, so never put a server secret here.

# Where the FastAPI server is. Leave empty to use the same origin: in
# development the Vite proxy sends /api to http://localhost:8000.
VITE_API_URL=

# The Supabase gateway, used for sign-in only.
VITE_SUPABASE_URL=http://localhost:54321

# The public anon key. Left empty, it is read from SUPABASE_ANON_KEY in the
# repo root .env, written by scripts/gen-env.py. Without either, the sign-in
# pages say sign-in is not configured, and the app needs an account.
VITE_SUPABASE_ANON_KEY=
